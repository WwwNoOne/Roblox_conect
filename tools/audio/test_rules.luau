local rules = require('../../src/StarterPlayer/StarterPlayerScripts/AudioCueRules')
assert(rules.CanUse(true,true,false,false), 'A living player exploring may hear cues')
assert(not rules.CanUse(true,true,false,true), 'Elevator safety suppresses chase')
assert(not rules.CanUse(true,true,true,false), 'Hiding suppresses chase')
assert(not rules.CanUse(false,true,false,false), 'Lobby is quiet')
assert(not rules.CanUse(true,false,false,false), 'Spectator does not hear personal chase')
assert(rules.CanHearChase('Chase',20,nil,'Player1',true), 'Nearby visible base pursuer')
assert(not rules.CanHearChase('Chase',20,nil,'Player1',false), 'Walls prevent starting music from an unassigned pursuer')
assert(not rules.CanHearChase('Charge',20,'Player2','Player1',true), 'Another target does not trigger personal music')
assert(rules.CanHearChase('Charge',20,'Player1','Player1',false), 'Own known charge remains a threat behind a corner')
assert(not rules.CanHearChase('FinalChase',200,'Player1','Player1',true), 'Distant threat stays quiet')
assert(not rules.CanHearChase('Patrol',5,nil,'Player1',true), 'Patrol is not chase')
assert(rules.ShowGenerator('Broken',30,true), 'Broken generator nearby')
assert(not rules.ShowGenerator('Repaired',5,true), 'Repaired marker disappears')
assert(not rules.ShowGenerator('Broken',43,true), 'No global map marker')
assert(not rules.ShowGenerator('Broken',10,false), 'No cue when dead/hidden/outside run')
print('15 audio and generator policy assertions passed')
